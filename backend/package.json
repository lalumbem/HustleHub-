{
  "name": "hustlehub-backend",
  "version": "1.0.0",
  "description": "HustleHub+ secure MERN freelance marketplace backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --ignore postman src/server.js",
    "dev:test": "set NODE_ENV=test&& nodemon --ignore postman src/server.js",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "test:api": "newman run postman/HustleHub.postman_collection.json -e postman/HustleHub.postman_environment.json --insecure"
  },
  "keywords": [
    "mern",
    "express",
    "jwt",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "xss": "^1.0.15",
    "mongoose": "^8.18.0",
    "express-mongo-sanitize": "^2.2.0"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "nodemon": "^3.1.4"
  }
}
