{
  "info": {
    "name": "HustleHub+ API",
    "description": "Backend test suite: auth, gig CRUD with ownership, bookings/transactions, and RBAC negative tests. Run against a locally running instance (npm run dev) with the HustleHub Local environment selected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('runId')) {",
          "    const runId = Date.now().toString();",
          "    pm.variables.set('runId', runId);",
          "    pm.variables.set('clientEmail', `client-${runId}@example.com`);",
          "    pm.variables.set('freelancerEmail', `freelancer-${runId}@example.com`);",
          "    pm.variables.set('owner2Email', `owner2-${runId}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lerato Freelancer\",\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"freelancer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Password not returned', () => pm.expect(pm.response.json().user.password).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Weak Password (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weak Pw\",\n  \"email\": \"weakpw-{{$randomInt}}@example.com\",\n  \"password\": \"123\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token present', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.environment.set('freelancerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('clientToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Second Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Second Freelancer\",\n  \"email\": \"{{owner2Email}}\",\n  \"password\": \"Password123\",\n  \"role\": \"freelancer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Second Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner2Email}}\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('owner2Token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"WrongPassword1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile Without Token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile With Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gigs",
      "item": [
        {
          "name": "Create Gig as Freelancer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Logo Design\",\n  \"description\": \"I will design a modern, minimal logo for your brand.\",\n  \"category\": \"Design\",\n  \"price\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('gigId', json.gig.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Gig as Client (expect 403 - RBAC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Fail\",\n  \"description\": \"Clients cannot create gigs.\",\n  \"category\": \"Design\",\n  \"price\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Browse All Gigs (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/gigs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a gigs array', () => pm.expect(pm.response.json().gigs).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS Payload in Gig Title (should be stripped)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"<script>alert(1)</script> Gig\",\n  \"description\": \"Testing sanitisation of script tags in input.\",\n  \"category\": \"Design\",\n  \"price\": 50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Script tag stripped from title', () => pm.expect(json.gig.title).to.not.include('<script>'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Gig as Owner",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs/{{gigId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 550\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Gig as Non-Owner (expect 403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs/{{gigId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (client is not owner, and RBAC blocks non-freelancers anyway)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Created Gig By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/gigs/{{gigId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Gig ID matches', () => pm.expect(pm.response.json().gig.id).to.eql(pm.environment.get('gigId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Gig Without Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/gigs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\":\"No Auth Gig\",\n  \"description\":\"This request should be rejected without JWT.\",\n  \"category\":\"Design\",\n  \"price\":100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Gig as Different Freelancer (expect 403 ownership)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{owner2Token}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs/{{gigId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Gig as Different Freelancer (expect 403 ownership)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{owner2Token}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs/{{gigId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Gig as Owner",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs/{{gigId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Gig for Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/gigs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Booking Test Gig\",\n  \"description\": \"A gig reserved for booking workflow tests.\",\n  \"category\": \"Testing\",\n  \"price\": 250\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('gigId', pm.response.json().gig.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Booking as Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Transaction created with matching amount', () => pm.expect(json.transaction).to.be.an('object'));",
                  "pm.environment.set('bookingId', json.booking.id);",
                  "pm.test('Transaction references booking', () => pm.expect(pm.response.json().transaction.bookingId).to.eql(pm.response.json().booking.id));",
                  "pm.test('Transaction amount is positive', () => pm.expect(pm.response.json().transaction.amount).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Booking as Freelancer (expect 403 - RBAC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Bookings as Client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Bookings array returned', () => pm.expect(pm.response.json().bookings).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Bookings as Freelancer (includes income)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{freelancerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Total income is a number', () => pm.expect(json.totalIncome).to.be.a('number'));",
                  "pm.test('Income reflects the booking made', () => pm.expect(json.totalIncome).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Bookings Without Token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
